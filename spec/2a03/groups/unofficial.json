      "fields": { "aaa": "7:5", "bbb": "4:2" },
      "mask": "0x03",
      "match": "0x03",
      "instructions": [
        { "selector": { "field": "aaa", "value": "000" }, "mnemonic": "SLO", "since": "Ricoh2A03", "unofficial": true, "manual_ref": "6502 §SLO — ASL + ORA", "cycles": { "form": "6m" }, "steps": [] },
