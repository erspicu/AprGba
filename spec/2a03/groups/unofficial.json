        { "selector": { "field": "aaa", "value": "010" }, "mnemonic": "SRE", "since": "Ricoh2A03", "unofficial": true, "manual_ref": "6502 §SRE — LSR + EOR", "cycles": { "form": "6m" }, "steps": [] },
        { "selector": { "field": "aaa", "value": "011" }, "mnemonic": "RRA", "since": "Ricoh2A03", "unofficial": true, "manual_ref": "6502 §RRA — ROR + ADC", "cycles": { "form": "6m" }, "steps": [] },
        { "selector": { "field": "aaa", "value": "100" }, "mnemonic": "SAX", "since": "Ricoh2A03", "unofficial": true, "manual_ref": "6502 §SAX — store A AND X", "cycles": { "form": "3m" }, "steps": [] },
        { "selector": { "field": "aaa", "value": "101" }, "mnemonic": "LAX", "since": "Ricoh2A03", "unofficial": true, "manual_ref": "6502 §LAX — load A and X", "cycles": { "form": "3m" }, "steps": [] },
        { "selector": { "field": "aaa", "value": "110" }, "mnemonic": "DCP", "since": "Ricoh2A03", "unofficial": true, "manual_ref": "6502 §DCP — DEC + CMP", "cycles": { "form": "6m" }, "steps": [] },
