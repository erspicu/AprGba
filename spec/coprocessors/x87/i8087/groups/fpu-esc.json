{
    "name": "FpuEscape",
    "comment": "Intel 8087 ESC opcodes (0xD8-0xDF). Each ESC byte gets its own format entry (mask=0xFF) with its own dispatcher emitter — splits Phase 28.IO's single catch-all (mask=0xF8) into 8 per-byte slots so individual sub-opcodes can be implemented incrementally. Phase 29.3+ each byte's dispatcher does a 2-tier switch: first on modrm.mod (00/01/10 = memory form, 11 = register form / no-operand op-extension), then on either modrm.reg (memory form) or the full 6-bit second-byte value (register form). Currently all 8 dispatchers fall through to no-op behavior — this keeps real-PC BIOS POST FPU detection happy. Each gets replaced with real semantics as the corresponding instructions ship: 29.3 (data movement: D9 /0 FLD, D9 /3 FSTP, D9 EE FLDZ, DB E3 FNINIT, etc.), 29.4 (arithmetic), 29.5 (compares), 29.6 (constants), 29.7 (transcendentals), 29.8 (misc), 29.9 (control).",
    "formats": [
        {
            "name": "FpuEscD8",
            "comment": "D8 — f32 arithmetic family (FADD/FMUL/FCOM/FCOMP/FSUB/FSUBR/FDIV/FDIVR with m32fp or ST(i)). Phase 29.4.",
            "fields": {},
            "mask": "0xFF",
            "match": "0xD8",
            "has_modrm": true,
            "instructions": [
                {
                    "mnemonic": "FPU_D8",
                    "since": "Intel8086",
                    "writes_pc": "never",
                    "manual_ref": "Intel SDM Vol.2 §FPU D8",
                    "cycles": { "form": "2" },
                    "steps": [ { "op": "x86_fetch_modrm" }, { "op": "x86_modrm_compute_ea" }, { "op": "x86_fpu_d8_dispatch" } ],
                    "id": "FPU_D8_dispatch"
                }
            ]
        },
        {
            "name": "FpuEscD9",
            "comment": "D9 — data movement + constants + misc (FLD m32fp, FST m32fp, FSTP m32fp, FLDENV, FLDCW, FSTENV, FSTCW + FLD ST(i), FXCH, FNOP, FCHS, FABS, FTST, FXAM, FLD1, FLDL2T, FLDL2E, FLDPI, FLDLG2, FLDLN2, FLDZ). Phase 29.3 + 29.6 + 29.9.",
            "fields": {},
            "mask": "0xFF",
            "match": "0xD9",
            "has_modrm": true,
            "instructions": [
                {
                    "mnemonic": "FPU_D9",
                    "since": "Intel8086",
                    "writes_pc": "never",
                    "manual_ref": "Intel SDM Vol.2 §FPU D9",
                    "cycles": { "form": "2" },
                    "steps": [ { "op": "x86_fetch_modrm" }, { "op": "x86_modrm_compute_ea" }, { "op": "x86_fpu_d9_dispatch" } ],
                    "id": "FPU_D9_dispatch"
                }
            ]
        },
        {
            "name": "FpuEscDA",
            "comment": "DA — i32 arithmetic / FCMOVcc (8087: integer arithmetic with m32int; P6+: FCMOVcc — we only support 8087-tier, so just the integer-arithmetic family).",
