{
  "name": "StackAndJump",
  "comment": "Stack push/pop + JSR/RTS/RTI + JMP variants. All have unique mask 0xFF opcodes (no encoding family).",
  "formats": [
    {
      "name": "PushAccumulator",  "pattern": "01001000", "fields": {}, "mask": "0xFF", "match": "0x48",
      "instructions": [{
        "mnemonic": "PHA", "since": "Ricoh2A03", "manual_ref": "6502 §PHA", "cycles": { "form": "3m" },
        "steps": [
          { "op": "read_reg_named", "name": "A", "out": "a" },
          { "op": "push8", "value": "a", "addr_base": 256, "pre_decrement": false }
        ]
      }]
    },
    {
      "name": "PullAccumulator",  "pattern": "01101000", "fields": {}, "mask": "0xFF", "match": "0x68",
      "instructions": [{
        "mnemonic": "PLA", "since": "Ricoh2A03", "manual_ref": "6502 §PLA", "cycles": { "form": "4m" },
        "steps": [
          { "op": "pop8", "addr_base": 256, "pre_increment": true, "out": "v" },
          { "op": "write_reg_named", "name": "A", "value": "v" },
          { "op": "update_zero", "in": "v", "reg": "P", "flag": "Z" },
          { "op": "update_sign", "in": "v", "reg": "P", "flag": "N" }
        ]
      }]
    },
    {
      "name": "PushProcessorStatus", "pattern": "00001000", "fields": {}, "mask": "0xFF", "match": "0x08",
      "instructions": [{
        "mnemonic": "PHP", "since": "Ricoh2A03", "manual_ref": "6502 §PHP — pushes P with B=1 U=1", "cycles": { "form": "3m" },
        "steps": [
          { "op": "read_reg_named", "name": "P", "out": "p" },
          { "op": "or", "in": ["p", { "const": 48 }], "out": "p_break" },
          { "op": "push8", "value": "p_break", "addr_base": 256, "pre_decrement": false }
        ]
      }]
    },
    {
      "name": "PullProcessorStatus", "pattern": "00101000", "fields": {}, "mask": "0xFF", "match": "0x28",
      "instructions": [{
        "mnemonic": "PLP", "since": "Ricoh2A03", "manual_ref": "6502 §PLP — restores P (B/U bits ignored)", "cycles": { "form": "4m" },
        "steps": [
          { "op": "pop8", "addr_base": 256, "pre_increment": true, "out": "p_pulled" },
          { "op": "and", "in": ["p_pulled", { "const": 239 }], "out": "p_no_b" },
          { "op": "or", "in": ["p_no_b", { "const": 32 }], "out": "p_final" },
          { "op": "write_reg_named", "name": "P", "value": "p_final" }
        ]
      }]
    },
    {
      "name": "JumpToSubroutine", "pattern": "00100000", "fields": {}, "mask": "0xFF", "match": "0x20",
      "instructions": [{
        "mnemonic": "JSR", "since": "Ricoh2A03", "writes_pc": "always", "manual_ref": "6502 §JSR abs", "cycles": { "form": "6m" },
        "steps": [
          { "op": "mos_jsr" }
        ]
      }]
    },
    {
      "name": "ReturnFromSubroutine", "pattern": "01100000", "fields": {}, "mask": "0xFF", "match": "0x60",
      "instructions": [{
        "mnemonic": "RTS", "since": "Ricoh2A03", "writes_pc": "always", "manual_ref": "6502 §RTS", "cycles": { "form": "6m" },
        "steps": [
          { "op": "mos_rts" }
        ]
      }]
    },
    {
      "name": "ReturnFromInterrupt", "pattern": "01000000", "fields": {}, "mask": "0xFF", "match": "0x40",
      "instructions": [{
        "mnemonic": "RTI", "since": "Ricoh2A03", "writes_pc": "always", "manual_ref": "6502 §RTI", "cycles": { "form": "6m" },
        "steps": [
          { "op": "mos_rti" }
        ]
      }]
    },
    {
      "name": "JumpAbsolute",     "pattern": "01001100", "fields": {}, "mask": "0xFF", "match": "0x4C",
      "instructions": [{
        "mnemonic": "JMP", "since": "Ricoh2A03", "writes_pc": "always", "manual_ref": "6502 §JMP abs", "cycles": { "form": "3m" },
        "steps": [
          { "op": "read_imm16", "out": "target" },
          { "op": "write_reg_named", "name": "PC", "value": "target" }
        ]
      }]
    },
    {
      "name": "JumpIndirect",     "pattern": "01101100", "fields": {}, "mask": "0xFF", "match": "0x6C",
      "instructions": [{
        "mnemonic": "JMP_IND", "since": "Ricoh2A03", "writes_pc": "always", "manual_ref": "6502 §JMP () — has page-cross bug", "cycles": { "form": "5m" },
        "steps": [
          { "op": "mos_jmp_indirect", "out": "target" },
          { "op": "write_reg_named", "name": "PC", "value": "target" }
        ]
      }]
    }
  ]
}
