{
    "$schema": "../schema/machine-spec.schema.json",
    "spec_version": "2.0",
    "name": "gba",
    "cpu": "ARMv4T",
    "unmapped_behavior": "last_bus_value",
    "memory_regions": [
        {
            "name": "bios",
            "addr_start": "0x00000000",
            "addr_end_exclusive": "0x00004000",
            "type": "rom",
            "handler": "bios",
            "fastmem_eligible": true,
            "readable": true,
            "writable": false,
            "allowed_widths": [8, 16, 32],
            "side_effects": ["bios_open_bus"]
        },
        {
            "name": "ewram",
            "addr_start": "0x02000000",
            "addr_end_exclusive": "0x02040000",
            "type": "ram",
            "handler": "ewram",
            "fastmem_eligible": true,
            "readable": true,
            "writable": true,
            "allowed_widths": [8, 16, 32],
            "smc_notify": true,
            "wait_states": { "seq": 2, "nonseq": 2 }
        },
        {
            "name": "iwram",
            "addr_start": "0x03000000",
            "addr_end_exclusive": "0x03008000",
            "type": "ram",
            "handler": "iwram",
            "fastmem_eligible": true,
            "readable": true,
            "writable": true,
            "allowed_widths": [8, 16, 32],
            "smc_notify": true
        },
        {
            "name": "io",
            "addr_start": "0x04000000",
            "addr_end_exclusive": "0x04000400",
            "type": "io",
            "handler": "ioregs",
            "readable": true,
            "writable": true,
            "volatile": true,
            "allowed_widths": [16, 32],
            "forces_end_of_block": false,
            "observers": ["dispstat", "if", "ie", "ime", "dma", "timer"]
        },
        {
            "name": "palette",
            "addr_start": "0x05000000",
            "addr_end_exclusive": "0x05000400",
            "type": "ram",
            "handler": "palette",
            "readable": true,
            "writable": true,
            "allowed_widths": [16, 32],
            "side_effects": ["ppu_palette"]
        },
        {
            "name": "vram",
            "addr_start": "0x06000000",
            "addr_end_exclusive": "0x06018000",
            "type": "ram",
            "handler": "vram",
            "fastmem_eligible": false,
            "readable": true,
            "writable": true,
            "allowed_widths": [16, 32],
            "side_effects": ["ppu_vram"]
        },
        {
            "name": "oam",
            "addr_start": "0x07000000",
            "addr_end_exclusive": "0x07000400",
            "type": "ram",
            "handler": "oam",
            "readable": true,
            "writable": true,
            "allowed_widths": [16, 32],
            "side_effects": ["ppu_oam"]
        },
        {
            "name": "cart_rom",
            "addr_start": "0x08000000",
            "addr_end_exclusive": "0x0E000000",
            "type": "rom",
            "handler": "cart",
            "fastmem_eligible": true,
            "readable": true,
            "writable": false,
            "allowed_widths": [8, 16, 32],
            "wait_states": { "seq": 2, "nonseq": 4 }
        }
    ],
    "interrupt_vectors": {
        "reset":             "0x00000000",
        "undefined":         "0x00000004",
        "swi":               "0x00000008",
        "prefetch_abort":    "0x0000000C",
        "data_abort":        "0x00000010",
        "irq":               "0x00000018",
        "fiq":               "0x0000001C"
    }
}
