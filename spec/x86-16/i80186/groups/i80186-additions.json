[
  {
    "name": "PushSpI80186",
    "comment": "0x54 PUSH SP — 80186 silicon-quirk fix vs i8086. Pushes the PRE-decrement SP value (i.e. the SP that callers see before the push), not the post-decrement one. mask=0xFF wins over parent's PUSH_reg16 (mask=0xF8 match=0x50) for byte 0x54 only because additions are prepended in the EncodingGroups list. Other PUSH r16 (AX/CX/DX/BX/BP/SI/DI) still go through parent's emitter unchanged.",
    "fields": {},
    "mask": "0xFF",
    "match": "0x54",
    "instructions": [
      {
        "id": "PUSH_SP_i80186",
        "mnemonic": "PUSH",
        "since": "Intel80186",
        "writes_pc": "never",
        "manual_ref": "Intel iAPX 186 §PUSH",
        "cycles": { "form": "10" },
        "steps": [
          { "op": "x86_push_sp_pre_decrement" }
        ]
      }
    ]
  },

