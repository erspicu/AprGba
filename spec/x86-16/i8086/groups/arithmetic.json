        { "op": "x86_fetch_modrm" }, { "op": "x86_modrm_compute_ea" },
        { "op": "x86_modrm_load_w8",     "out": "lhs" },
        { "op": "x86_read_reg8_field",   "field": "modrm_reg", "out": "rhs" },
        { "op": "x86_alu_w8", "kind": "add", "lhs": "lhs", "rhs": "rhs", "out": "result" },
        { "op": "x86_modrm_store_w8",    "in": ["result"] }
    ]}]},
