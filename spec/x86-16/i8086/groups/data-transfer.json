      "fields": { "reg": "2:0" },
      "mask":  "0xF8",
      "match": "0xB0",
      "instructions": [
        {
          "mnemonic":   "MOV",
          "since":      "Intel8086",
          "writes_pc":  "never",
          "manual_ref": "Intel SDM Vol.2 §MOV",
